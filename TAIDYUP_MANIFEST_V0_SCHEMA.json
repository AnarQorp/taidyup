{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tAIdyup Declaration Manifest V0 Schema",
  "type": "object",
  "required": ["version", "project", "agents"],
  "properties": {
    "version": { "type": "string" },
    "project": { "type": "string" },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "purpose", "owner"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "purpose": { "type": "string" },
          "owner": {
            "type": "object",
            "required": ["name", "email"],
            "properties": {
              "name": { "type": "string" },
              "email": { "type": "string" }
            }
          },
          "provider": { "type": "string" },
          "framework": { "type": "string" },
          "model": { "type": "string" },
          "tools": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "category": { "type": "string" }
              }
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["action", "resource"],
              "properties": {
                "action": {
                  "type": "string",
                  "enum": ["READ", "WRITE", "CREATE", "UPDATE", "DELETE", "EXECUTE", "SEND", "PUBLISH", "APPROVE", "PURCHASE", "TRANSFER", "ADMIN"]
                },
                "resource": { "type": "string" },
                "constraints": { "type": "object" }
              }
            }
          },
          "oversight": {
            "type": "object",
            "properties": {
              "human_in_the_loop": { "type": "boolean" },
              "approval_required": { "type": "string" },
              "revocation_mechanism": { "type": "string" }
            }
          },
          "revocation": {
            "type": "object",
            "properties": {
              "mechanism": { "type": "string" },
              "type": { "type": "string" }
            }
          },
          "external_references": {
            "type": "object",
            "properties": {
              "sbom": { "type": "string" },
              "mcp_server": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
